#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    string name;
    vector<int> marks;

    srand(time(0));

    cout << "Enter your full name: ";
    getline(cin, name);

    if (name.empty()) {
        cout << "Name is empty" << endl;
        return 0;
    }

    cout << "Name length: " << name.length() << endl;

    if (name.find(" ") != string::npos) {
        cout << "Full name detected" << endl;
    } else {
        cout << "Only one word name detected" << endl;
    }

    int studentId = rand() % 9000 + 1000;
    cout << "Random student ID: " << studentId << endl;

    marks.push_back(80);
    marks.push_back(95);
    marks.push_back(70);

    cout << endl;
    cout << "Marks count: " << marks.size() << endl;

    cout << "Marks before sort:" << endl;
    for (int i = 0; i < marks.size(); i++) {
        cout << marks[i] << endl;
    }

    sort(marks.begin(), marks.end());

    cout << "Marks after sort:" << endl;
    for (int i = 0; i < marks.size(); i++) {
        cout << marks[i] << endl;
    }

    marks.pop_back();

    cout << "After deleting last mark:" << endl;
    for (int i = 0; i < marks.size(); i++) {
        cout << marks[i] << endl;
    }

    marks.erase(marks.begin());

    cout << "After deleting first mark:" << endl;
    for (int i = 0; i < marks.size(); i++) {
        cout << marks[i] << endl;
    }

    return 0;
}
