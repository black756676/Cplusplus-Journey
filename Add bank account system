#include <iostream>
#include <vector>
#include <string>
using namespace std;

class BankAccount {
private:
    string holderName;
    double balance;
    vector<string> transactions;

public:
    BankAccount(string name, double startingBalance) {
        holderName = name;

        if (startingBalance >= 0) {
            balance = startingBalance;
        } else {
            balance = 0;
        }

        transactions.push_back("Account created");
    }

    void deposit(double amount) {
        if (amount <= 0) {
            cout << "Invalid deposit amount" << endl;
            return;
        }

        balance = balance + amount;
        transactions.push_back("Deposited money");
        cout << "Deposit successful" << endl;
    }

    void withdraw(double amount) {
        if (amount <= 0) {
            cout << "Invalid withdraw amount" << endl;
            return;
        }

        if (amount > balance) {
            cout << "Insufficient balance" << endl;
            return;
        }

        balance = balance - amount;
        transactions.push_back("Withdrawn money");
        cout << "Withdraw successful" << endl;
    }

    void showBalance() {
        cout << "Account Holder: " << holderName << endl;
        cout << "Balance: " << balance << endl;
    }

    void showTransactions() {
        cout << "===== Transaction History =====" << endl;

        for (int i = 0; i < transactions.size(); i++) {
            cout << i + 1 << ". " << transactions[i] << endl;
        }
    }
};

int main() {
    string name;
    double startingBalance;
    int choice;

    cout << "===== Bank Account System =====" << endl;

    cout << "Enter account holder name: ";
    getline(cin, name);

    cout << "Enter starting balance: ";
    cin >> startingBalance;

    BankAccount account(name, startingBalance);

    do {
        cout << endl;
        cout << "===== Menu =====" << endl;
        cout << "1. Deposit" << endl;
        cout << "2. Withdraw" << endl;
        cout << "3. Show Balance" << endl;
        cout << "4. Show Transactions" << endl;
        cout << "5. Exit" << endl;
        cout << "Choice: ";
        cin >> choice;

        if (choice == 1) {
            double amount;
            cout << "Enter deposit amount: ";
            cin >> amount;

            account.deposit(amount);

        } else if (choice == 2) {
            double amount;
            cout << "Enter withdraw amount: ";
            cin >> amount;

            account.withdraw(amount);

        } else if (choice == 3) {
            account.showBalance();

        } else if (choice == 4) {
            account.showTransactions();

        } else if (choice == 5) {
            cout << "Thank you for using bank system" << endl;

        } else {
            cout << "Wrong choice" << endl;
        }

    } while (choice != 5);

    return 0;
}
